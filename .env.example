# Each deployment of this website is tied to ONE store in the admin panel.
# Copy this file to .env.local (or .env) before running `npm run build`.
# These are read at BUILD time by scripts/import-products.js (see
# package.json's "prebuild" script) — the site is a static export, so
# picking up new admin-panel products means rebuilding and redeploying,
# not something that happens live on its own.

# The store's slug in the admin panel (Settings -> Store profile, or shown
# in the Products -> Export dialog).
# Deploying a second website for a different store? Give it its own
# .env.local with that store's own slug — each site only ever shows its
# own store's products.
STORE_SLUG=

# The admin backend's base URL, reachable from wherever this builds (your
# machine or your CI/host's build step).
API_URL=http://localhost:8491
