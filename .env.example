# Each deployment of this website is tied to ONE store in the admin panel.
# Copy this file to .env.local before running `npm run dev` / `npm run build`
# && `npm start`. These are read at REQUEST time (not just build time) —
# the site fetches this store's catalog from the backend on each request
# and revalidates on a timer, so admin-panel product changes show up
# without a rebuild or redeploy. That means the site must run as a live
# Node process (`npm start`, i.e. `next start`) — it can no longer be
# deployed as plain static files.

# The store's slug in the admin panel (Settings -> Store profile, or shown
# in the Products -> Export dialog).
# Deploying a second website for a different store? Give it its own
# .env.local with that store's own slug — each site only ever shows its
# own store's products.
STORE_SLUG=

# The admin backend's base URL, reachable from wherever this website's
# Node server runs (not just your browser).
API_URL=http://localhost:8491

# How often (seconds) the underlying fetch considers itself fresh. The
# actual revalidation window pages use is the literal `export const
# revalidate = 60` in app/layout.tsx, app/shop/page.tsx,
# app/category/[slug]/page.tsx and app/product/[id]/page.tsx (Next requires
# a literal there, not an env var) — if you change this, edit those 4
# literals to match. Default 60.
CATALOG_REVALIDATE_SECONDS=60
