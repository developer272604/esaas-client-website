# Each deployment of this website is tied to ONE store in the admin panel.
# Copy this file to .env.local and set these before running `npm run build`
# (or `npm run import-products` on its own).

# The store's slug in the admin panel (Settings -> Store profile).
# Deploying a second website for a different store? Point it at that
# store's own slug — each site only ever gets its own store's products.
STORE_SLUG=

# The admin backend's base URL.
API_URL=http://localhost:8491
