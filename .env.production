# Public address of this storefront. Used for canonical URLs, share images, the sitemap
# and structured data. Not a secret, so it is committed. A host's build setting with the
# same name (for example in Cloudflare Pages) overrides this value: set it there when this
# template is deployed for another store or moves to its own domain.
NEXT_PUBLIC_SITE_URL=https://esaas-client-website.pages.dev
